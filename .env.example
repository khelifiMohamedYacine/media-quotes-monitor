# Copy to .env and fill in. .env is git-ignored.
# LLM provider: groq (default, free tier, open-weight model) | huggingface | anthropic
MQM_LLM_PROVIDER=groq
GROQ_API_KEY=
# MQM_GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face Inference Providers:
# MQM_LLM_PROVIDER=huggingface
# HF_TOKEN=
# MQM_HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# MQM_HF_PROVIDER=auto
# Optional cost tracking for open models, USD per 1M tokens:
# MQM_PRICE_IN=0.13
# MQM_PRICE_OUT=0.60

# To use Claude instead:
# MQM_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MQM_MODEL=claude-opus-5-5
# MQM_EFFORT_EXTRACT=low
# MQM_EFFORT_OBSOLESCENCE=medium
# MQM_EFFORT_SUMMARY=low

# MQM_REQUEST_DELAY=1.0
