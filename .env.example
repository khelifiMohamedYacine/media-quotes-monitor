# Copy to .env and fill in. .env is git-ignored.

# LLM provider:
#   auto (default) - fallback chain, in the order of MQM_LLM_CHAIN: a local Ollama model first
#                    (no key, no rate limit, no cost), then each hosted provider that has a key.
#   ollama | groq | huggingface | anthropic - use only that provider.
MQM_LLM_PROVIDER=auto
# MQM_LLM_CHAIN=ollama,groq,huggingface,anthropic

# Ollama (local, https://ollama.com): `ollama pull qwen3:8b`, then keep Ollama running.
# MQM_OLLAMA_MODEL=qwen3:8b
# MQM_OLLAMA_URL=http://127.0.0.1:11434
# MQM_OLLAMA_TIMEOUT=900

# Groq (free tier, open-weight model):
GROQ_API_KEY=
# MQM_GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face Inference Providers:
# HF_TOKEN=
# MQM_HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# MQM_HF_PROVIDER=auto
# Optional cost tracking for open models, USD per 1M tokens:
# MQM_PRICE_IN=0.13
# MQM_PRICE_OUT=0.60

# Claude:
# ANTHROPIC_API_KEY=
# MQM_MODEL=claude-opus-5-5
# MQM_EFFORT_EXTRACT=low
# MQM_EFFORT_OBSOLESCENCE=medium
# MQM_EFFORT_SUMMARY=low

# MQM_REQUEST_DELAY=1.0
